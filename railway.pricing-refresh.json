{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "uv run python -m src.jobs.pricing_refresh",
    "cronSchedule": "17 7 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2,
    "ipv6EgressEnabled": true
  }
}
