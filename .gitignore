# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables - NEVER commit these files
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example
railway_vars.txt
.sessions.json
google-services.json
GoogleService-Info.plist

# Native signing artifacts - never commit keys, certificates, or export profiles.
*.jks
*.keystore
*.p12
*.mobileprovision
*.provisionprofile
**/keystore.properties
**/signing.properties
web/ios/ExportOptions.plist

# MCP server config - contains real API tokens
.mcp.json
web/.mcp.json

# Node / web app
node_modules/
web/dist/
*.tsbuildinfo

# Wrangler local cache - holds the Cloudflare account id and email
.wrangler/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# uv cache (lock file itself should be committed for apps)
.uv/

# Firebase CLI local cache
.firebase/

# Playwright
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/
