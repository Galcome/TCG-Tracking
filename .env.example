# Copy this to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Application ---
APP_ENV=development
APP_ROLE=api
DEBUG=false

# --- Database (Neon PostgreSQL) ---
# Local dev: matches docker-compose.yml credentials.
# Production: the Neon POOLED endpoint - the hostname containing "-pooler".
# Example:
# postgresql://<user>:<password>@ep-xxx-pooler.us-east-1.aws.neon.tech/<db>?sslmode=require
#
# The app uses NullPool (see src/database.py) so Neon can suspend compute when idle.
# Do not add client-side pooling here without reading that comment first.
DATABASE_URL=postgresql://myapp_user:localdev@localhost:5432/myapp

# The Neon DIRECT (unpooled) endpoint - no "-pooler" in the hostname.
# Used by Alembic and one-off admin tasks. Leave blank in production.
DIRECT_DATABASE_URL=

# --- Auth (Firebase) ---
# Firebase Console -> Project settings -> General -> Project ID.
# The backend verifies RS256 ID tokens against Google's public JWKS; there is no
# secret to store here. The project ID is both the expected audience and the
# issuer suffix, so it must match the frontend's Firebase project exactly.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Who is allowed to use the store ledger. Comma-separated, case-insensitive.
# REQUIRED IN PRODUCTION - the app refuses to start without it.
# Google sign-in is enabled, so any Google account can obtain a valid token for this
# Firebase project. A valid token proves identity; this list proves membership.
# Adding a person here plus a Firebase account is the whole invite process.
ALLOWED_MEMBER_EMAILS=

# --- CORS ---
# Dev: leave as * to allow all origins.
# Production: comma-separated list of allowed frontend URLs. Do not use * in production.
ALLOWED_ORIGINS=*
ALLOWED_ORIGIN_REGEX=

# --- Observability (Sentry) ---
# sentry.io -> your Python/FastAPI project -> Settings -> Client Keys (DSN)
# Leave blank to disable. Production sets this in Railway variables.
SENTRY_DSN=

# --- Card reading (optional) ---
# Google AI Studio -> Get API key. Used only to read card names off a photo on the rip
# screen; it is never asked what anything is worth. Leave blank and that button disappears
# while everything else keeps working.
GEMINI_API_KEY=
