# Copy this to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Application ---
APP_ENV=development
APP_ROLE=api
DEBUG=false

# --- Database (PostgreSQL) ---
# Local dev: matches docker-compose.yml credentials.
# Production Railway API/worker: use Supavisor session pooler, port 5432.
# Example:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler URLs on port 6543 require NullPool-style SQLAlchemy config.
DATABASE_URL=postgresql://myapp_user:localdev@localhost:5432/myapp
DIRECT_DATABASE_URL=
DIRECT_DB_PASSWORD=
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=270

# --- Auth (Supabase) ---
# Supabase Dashboard -> Settings -> API.
# New projects usually use asymmetric JWTs; legacy projects may use HS256.
# The backend supports both when SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_JWT_SECRET
# are aligned to the same project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional - only needed if your app does server-side Supabase admin operations.
# SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
# Dev: leave as * to allow all origins.
# Production: comma-separated list of allowed frontend URLs. Do not use * in production.
ALLOWED_ORIGINS=*
ALLOWED_ORIGIN_REGEX=

# --- Observability (Sentry) ---
# sentry.io -> your Python/FastAPI project -> Settings -> Client Keys (DSN)
# Leave blank to disable. Production sets this in Railway variables.
SENTRY_DSN=
