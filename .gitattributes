# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicit text files
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.env   text eol=lf
Makefile text eol=lf
Procfile text eol=lf

# Binary files — never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
