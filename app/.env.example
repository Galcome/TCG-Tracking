# Mobile app environment - copy to app/.env and fill in local values.
# app/.env is git-ignored and must never be committed.
#
# EXPO_PUBLIC_* vars are bundled into the app. Never put secrets here.

# --- API ---
# Production: your Railway service URL.
# Local dev on device: http://192.168.x.x:8000/api/v1 (your machine's LAN IP).
EXPO_PUBLIC_API_URL=https://your-railway-app.up.railway.app/api/v1

# --- Supabase (public auth keys only) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Observability (Sentry) ---
EXPO_PUBLIC_SENTRY_DSN=

# --- Firebase native SDKs (Android Crashlytics + Performance) ---
# For EAS cloud builds, create a sensitive EAS file env named GOOGLE_SERVICES_JSON.
# For local native builds, download google-services.json for the Android app package and
# leave this fallback path as-is.
GOOGLE_SERVICES_JSON_PATH=./google-services.json
