{
  "expo": {
    "name": "TCG Investments",
    "slug": "tcg-investments",
    "version": "0.1.6",
    "icon": "./assets/icon.png",
    "scheme": "tcginvestments",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.galcome.tcgtracking"
    },
    "android": {
      "package": "com.galcome.tcgtracking",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e1a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TCG Investments to select card photos for identity suggestions.",
          "cameraPermission": "Allow TCG Investments to photograph cards for identity suggestions.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TCG Investments to scan cards so it can name and price them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
