{
  "name": "tcg-investments-app",
  "version": "0.1.3",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "release:preflight": "node scripts/release-preflight.mjs",
    "eas-build-pre-install": "node scripts/release-preflight.mjs",
    "mobile:android:doctor": "powershell -NoProfile -File scripts/mobile/android-local-release.ps1 doctor",
    "mobile:android:build:local": "powershell -NoProfile -File scripts/mobile/android-local-release.ps1 build",
    "mobile:android:distribute:local": "powershell -NoProfile -File scripts/mobile/android-local-release.ps1 distribute",
    "mobile:android:release:local": "powershell -NoProfile -File scripts/mobile/android-local-release.ps1 release",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist --clear",
    "export:android": "expo export --platform android --output-dir dist-android --clear",
    "export:ios": "expo export --platform ios --output-dir dist-ios --clear"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/perf": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.102.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
