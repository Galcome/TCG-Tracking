# Web app environment - copy to web/.env and fill in local values.
# web/.env is git-ignored and must never be committed.
#
# VITE_* vars are bundled into the client. Never put secrets here.
# Firebase web config is public by design; access is controlled by who has an
# account in the Firebase project, plus backend token verification.

# --- API ---
# Production: your Railway service URL.
# Local dev: http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- Auth (Firebase) ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app config.
# VITE_FIREBASE_PROJECT_ID must match the backend's FIREBASE_PROJECT_ID exactly,
# or every authenticated request returns 401.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Observability (Sentry) ---
# Leave blank to disable.
VITE_SENTRY_DSN=
